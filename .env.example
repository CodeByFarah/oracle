# Copy to .env (git-ignored) and fill in. Never commit real values.

# dev | research | paper | live
ORACLE_ENVIRONMENT=dev

# Local data lake root (raw/, normalized/, features/, manifests/)
ORACLE_DATA_ROOT=data

# PostgreSQL (docker-compose maps the container to 127.0.0.1:${ORACLE_PG_PORT})
ORACLE_PG_PORT=55433
POSTGRES_USER=oracle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oracle
ORACLE_DATABASE_URL=postgresql+psycopg://oracle:change-me@127.0.0.1:55433/oracle

# ---- Data providers ($0 policy: only free sources are required) ----
# FRED/ALFRED: free key, registration only (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=
# SEC EDGAR: free, no key. SEC fair-access policy requires a descriptive User-Agent with a
# contact, e.g. "ORACLE research your-name your-email@example.com". Provider disabled if empty.
ORACLE_SEC_USER_AGENT=

# Alpaca free market-data plan (free account, no payment): historical minute/daily bars,
# except the most recent 15 minutes. Personal use only; do not redistribute.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Tiingo free plan (free account, no payment): daily prices, 500 symbols/month, 50 requests/hour.
TIINGO_API_KEY=

# Databento (PAID, OPTIONAL). Disabled without a key and without `uv sync --extra databento`.
# Any request whose quoted cost exceeds this budget is refused before download.
DATABENTO_API_KEY=
ORACLE_DATABENTO_MAX_COST_USD=0

# Live trading is disabled by default and additionally requires ORACLE_ENVIRONMENT=live
# plus a human authorization record (Phase 16). Do not change this in dev.
ORACLE_LIVE_TRADING_ENABLED=false
